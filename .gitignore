# v's own self-vendoring manifest (this repo is also a v workspace)
vendors.toml

# GoReleaser build output
dist/

# Generated documentation site
site/

# Generated reference pages, both rebuilt by every `task build:docs`:
# api.md from `go doc`, cli/ from the cobra command tree.
docs/content/reference/api.md
docs/content/reference/cli/

# Containerized-tooling caches (Go module/build cache, golangci-lint cache),
# redirected here by the Taskfile so they are host-owned and persistent.
.cache/

# Test artifact
test-v

# go-task fingerprint cache (sources/status checksums)
.task/

# Per-user local Claude Code settings (the shared .claude/docs/ stays tracked).
# Ignored here too so it doesn't depend on a contributor's global gitignore.
.claude/settings.local.json
